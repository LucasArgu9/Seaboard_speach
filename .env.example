# ============================================================================
#  DESAFÍO SEABOARD · variables de entorno
#  Copiá este archivo a .env.local y completá los valores.
# ============================================================================

# --- Supabase (Project Settings > API) --------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...          # SECRETO — solo servidor

# Espejo público (mismo valor) para el cliente Realtime del navegador
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Panel /admin ---------------------------------------------------------
ADMIN_PASSWORD=cambiar-esta-clave
ADMIN_SESSION_SECRET=otro-secreto-largo-aleatorio-32-chars-min

# --- Juego --------------------------------------------------------------
# Tope de jugadores por ronda (el spec original decía 5; subido a 10).
NEXT_PUBLIC_MAX_PLAYERS=10

# --- URLs -------------------------------------------------------------------
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
